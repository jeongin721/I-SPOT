# ============================================================
# I-SPOT Environment Variables
# 실제 API Key / 인증값은 이 파일에 작성하지 않는다.
# 로컬에서는 .env 파일을 생성하여 실제 값을 설정한다.
# ============================================================

# ------------------------------------------------------------
# STT Provider
# ------------------------------------------------------------
# mock      : API 없이 로컬 테스트
# deepgram  : 현재 메인 STT
# whisper   : OpenAI Whisper 기반 STT
# clova     : CLOVA Speech 연동
I_SPOT_STT_PROVIDER=elevenlabs
I_SPOT_STT_FALLBACK_PROVIDER=deepgram
# Opt-in prototype only. A valid ElevenLabs one-speaker result otherwise
# remains UNKNOWN/UNRESOLVED; this must not be enabled by default.
I_SPOT_SINGLE_SPEAKER_FALLBACK=off

# 공통 STT API Key / URL
# provider별 설정에 따라 선택적으로 사용
I_SPOT_STT_API_KEY=
I_SPOT_STT_API_URL=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_LANGUAGE_CODE=kor
ELEVENLABS_DIARIZE=true

# ------------------------------------------------------------
# Speaker Diarization
# ------------------------------------------------------------
I_SPOT_SPEAKER_DIARIZATION_PROVIDER=
I_SPOT_SPEAKER_DIARIZATION_MODEL=

# ------------------------------------------------------------
# OpenAI / Whisper / RAG Embedding + Evidence Analyzer
# ------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------
# I-SPOT RAG
# ------------------------------------------------------------
RAG_DATA_DIR=rag_data
RAG_VECTOR_DB_DIR=rag_storage/chroma
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANALYZER_MODEL=gpt-5.6-luna
RAG_COLLECTION_NAME=ispot_child_abuse
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# ------------------------------------------------------------
# 국가법령정보센터 Open API
# 승인 후 발급받은 OC 인증값은 .env에만 입력한다.
# ------------------------------------------------------------
LAW_API_OC=
LAW_SEARCH_URL=https://www.law.go.kr/DRF/lawSearch.do
LAW_SERVICE_URL=https://www.law.go.kr/DRF/lawService.do
LAW_PORTAL_URL=https://www.law.go.kr/LSW
LAW_CACHE_DIR=law_cache
LAW_TIMEOUT_SECONDS=15
LAW_CACHE_MAX_AGE_HOURS=24
LAW_TARGET_LAWS=아동복지법,아동학대범죄의 처벌 등에 관한 특례법

# ------------------------------------------------------------
# Groq / LLM Analyzer (Optional)
# ------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------
# Pyannote Experiment (Optional / NOT production)
# ------------------------------------------------------------
# Pyannote diarization 실험을 재현할 경우에만 사용
# 현재 메인 STT pipeline에는 Pyannote를 사용하지 않음.
PYANNOTE_AUTH_TOKEN=


# ------------------------------------------------------------
# 법령·매뉴얼 AI 질의 (law/, manual/, ai/modeling/abuse/legal_manual_qa_llm.py)
# ------------------------------------------------------------
# 국가법령정보센터 Open API 인증키. 없으면 law/client.py 호출이 실패한다.
LAW_API_OC=
# 법령 조문 캐시 디렉터리. 비우면 <repo>/law_cache 를 쓴다.
LAW_CACHE_DIR=
# "2026년 아동학대 대응 업무 매뉴얼" 6장(서식·참고자료) 촬영본 이미지
# 디렉터리. 저작권 있는 정부 발간물 원본이라 git에 커밋하지 않는다 —
# 로컬에 따로 받아 경로를 지정해야 매뉴얼 질의가 이미지를 첨부한다.
# 비우면 <repo>/사례관리_업무 를 쓴다.
MANUAL_IMAGE_DIR=
# 매뉴얼 사진을 LLM(OpenAI)에 첨부할지(기본 false). 매뉴얼은 기관 대외비 — 기관 허락 전에는 켜지 않는다.
MANUAL_QA_ATTACH_IMAGES=false
