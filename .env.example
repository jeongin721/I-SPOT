# STT provider configuration
# I_SPOT_STT_PROVIDER는 어떤 STT 엔진을 사용할지 결정한다.
# mock: 로컬 테스트용 안전한 대체 구현
# whisper: OpenAI Whisper 연동
# clova: CLOVA Speech 연동용 키
I_SPOT_STT_PROVIDER=mock
I_SPOT_STT_API_KEY=
I_SPOT_STT_API_URL=

# Speaker diarization configuration
# mock: 로컬 개발용 대체 화자 분리 시뮬레이션
# pyannote: 실제 화자 분리 모델 연동
I_SPOT_SPEAKER_DIARIZATION_PROVIDER=mock
I_SPOT_SPEAKER_DIARIZATION_MODEL=

# Optional fallback keys
# OpenAI Whisper를 사용할 경우 OPENAI_API_KEY를 여기서 설정할 수 있다.
OPENAI_API_KEY=

# Optional diarization auth
PYANNOTE_AUTH_TOKEN=
