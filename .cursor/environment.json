{
  "name": "I-SPOT Backend",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && . .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "I-SPOT FastAPI 서버 (http://localhost:8000, docs: /docs)"
    }
  ],
  "ports": [
    {
      "name": "backend api",
      "port": 8000
    }
  ]
}
