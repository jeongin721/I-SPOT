# I-SPOT Backend 환경변수 예시
# 실제 .env 파일은 git 에 커밋하지 않는다.

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
ENV=local
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# docker compose 사용 시 host 는 db, 로컬 직접 실행 시 localhost
DATABASE_URL=postgresql+psycopg://ispot:ispot@localhost:5432/ispot
DB_ECHO=false

# ---------------------------------------------------------
# Auth
# ---------------------------------------------------------
# 32 byte 이상 임의 문자열을 사용한다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------------------------------------------------
# 비밀번호 규칙 (새로 정하는 비밀번호에만 적용)
# ---------------------------------------------------------
# 기본값은 팀 회의 결정(2026-09-18) "8자 이상, 영문·숫자·특수문자 포함" 이다.
# 종류는 글자·숫자·특수문자 3가지로 세므로 3 이면 전부 포함해야 한다.
# PASSWORD_PASSPHRASE_LENGTH: 이 길이 이상이면 종류를 보지 않는다. 0 이면 면제 없음(팀 결정).
# 켤 때는 12~72 만 받는다.
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_CLASSES=3
PASSWORD_PASSPHRASE_LENGTH=0

# ---------------------------------------------------------
# 계정 상태 (팀 회의 결정 2026-09-18)
# ---------------------------------------------------------
# LOGIN_LOCK_MINUTES=0 이면 시간이 지나도 풀리지 않고 관리자만 해제한다.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=0
DORMANT_AFTER_DAYS=60
TEMP_PASSWORD_VALID_HOURS=72
# 이전 비밀번호 재사용 금지에 쓸 보관 개수. 0 이면 검사하지 않는다.
PASSWORD_HISTORY_COUNT=3

# ---------------------------------------------------------
# CORS (Frontend 주소)
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------
# Audio Storage (9월 MVP 는 Local Storage)
# ---------------------------------------------------------
AUDIO_STORAGE_ROOT=../storage/audio
AUDIO_MAX_SIZE_MB=200
# 음성 업로드가 아닌 요청 본문의 최대 크기(MB). 본문을 받는 창구(JSON · form)에서 넘으면 로그인 확인 전에
# 400 으로 막는다. 본문을 읽지 않는 창구(GET 등)는 보낸 본문을 무시한다.
REQUEST_MAX_BODY_MB=2
AUDIO_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.mp4,.ogg,.flac,.webm

# ---------------------------------------------------------
# STT (팀 A)
# ---------------------------------------------------------
# mock   : 팀 A 산출물 없이 Backend 단독 실행/통합
# module : 실제 STT 함수 호출
STT_PROVIDER=mock
STT_MODULE=stt.transcribe_service
STT_FUNCTION=transcribe
STT_TIMEOUT_SECONDS=600

# 구간별 음성 참고 표시(stt/voice_marks, 정담원 님). STT 저장 직후 아동 구간의 떨림 · 웅얼거림 · 작은 소리 참고 표시를
# 계산해 audio_features 에 새 행으로 저장한다(API_CONTRACT 16절). 참고 표시일 뿐 판정이 아니다.
# off(기본): 아무것도 안 함. module: stt.voice_marks 호출(librosa · numba · soundfile — requirements-stt.txt, 이미지는 WITH_STT=1).
VOICE_MARKS_PROVIDER=off
VOICE_MARKS_MODULE=stt.voice_marks
VOICE_MARKS_FUNCTION=analyze_voice_marks
# 한 번의 제한 시간(초). 넘기면 UNDETERMINED · ANALYSIS_ERROR 행을 남기고 회차 상태는 그대로 둔다.
VOICE_MARKS_TIMEOUT_SECONDS=600
# numba 가 컴파일 결과를 둘 폴더(쓰기 가능해야 한다). Docker 이미지는 /tmp/numba-cache 로 둔다. 로컬은 비워 두면 기본 자리.
# NUMBA_CACHE_DIR=

# ---------------------------------------------------------
# stt/ 패키지 내부 설정 (STT_PROVIDER=module 일 때만 사용)
# ---------------------------------------------------------
# 위 STT_PROVIDER 는 "Backend 가 STT 모듈을 호출할지" 를 정하고,
# 아래 I_SPOT_* 는 "그 모듈이 어떤 엔진으로 받아쓸지" 를 정한다.
#
# mock     : 오프라인 대체 구현 (기본값, 키 불필요)
# whisper  : OpenAI Whisper  -> OPENAI_API_KEY
# deepgram : Deepgram        -> DEEPGRAM_API_KEY
# clova    : CLOVA Speech    -> I_SPOT_STT_API_KEY / I_SPOT_STT_API_URL
I_SPOT_STT_PROVIDER=elevenlabs
I_SPOT_STT_FALLBACK_PROVIDER=deepgram
# Opt-in prototype only; keep disabled until runtime replay validation passes.
I_SPOT_SINGLE_SPEAKER_FALLBACK=off
I_SPOT_STT_API_KEY=
I_SPOT_STT_API_URL=

# 1/true/yes/on 이면 동일 화자의 연속 발화를 병합하는 후처리를 적용한다.
I_SPOT_STT_POSTPROCESS=

# 화자 분리(diarization)
# mock     : 로컬 개발용 시뮬레이션 (기본값)
# pyannote : 실제 모델 사용 -> PYANNOTE_AUTH_TOKEN 및 pyannote-audio 별도 설치 필요
I_SPOT_SPEAKER_DIARIZATION_PROVIDER=mock
I_SPOT_SPEAKER_DIARIZATION_MODEL=
PYANNOTE_AUTH_TOKEN=

# stt/ispot_stt.py(Deepgram provider) 에서 사용
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_LANGUAGE_CODE=kor
ELEVENLABS_DIARIZE=true

# stt/ispot_analyzer.py(Groq LLM 위험도 분석) 에서 사용
GROQ_API_KEY=

# ---------------------------------------------------------
# AI (팀 B)
# ---------------------------------------------------------
# mock      : Transcript 에서 파생한 합성 요약 반환. 외부 호출 없음
# pipeline  : ai/services/analysis_pipeline.run_analysis_pipeline 호출
#             상담 원문을 비식별 없이 OpenAI 로 보낸다. 가상 데이터로만 쓴다.
#             ENV=production 에서는 아래 AI_PIPELINE_ALLOW_UNMASKED=true 가 없으면
#             서버가 시작하지 않는다(막은 이유가 오류 문구로 나온다)
# langgraph : agent/graph.run 호출 (비식별 → 분석 → 근거판정 → RAG → 재분석)
#             pip install -r ../requirements-agent.txt 가 선행되어야 한다
#             외부 LLM 호출 전 비식별 필수(9/18 회의 결정). 비식별은 아직
#             연결 전이고, 지금 그래프 노드는 LLM 을 부르지 않는다
# modeling  : ai/modeling/abuse/contract_adapter 호출(이경진 님 파이프라인)
#             torch · transformers · openai 와 가중치 파일이 따로 필요하다(backend 의존성에 없음)
#             가린 글을 OpenAI 로 보내지만 가리기가 아직 완전하지 않다. 가상 데이터로만 쓴다.
#             ENV=production 에서는 아래 AI_MODELING_ALLOW_IN_PRODUCTION=true 가 없으면
#             서버가 시작하지 않는다(막은 이유가 오류 문구로 나온다)
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=180
# STT 검수 '1차 임시 핵심 발화' 스캔 한 번의 제한 시간(AI_PROVIDER=modeling 일 때만 STT 작업 끝에서 돈다).
# 넘기면 key_scan.status=FAILED 이고 STT 는 그대로 성공이다(API_CONTRACT 7절).
KEY_SCAN_TIMEOUT_SECONDS=30
# modeling 이 마감 시각(deadline)을 받는 판일 때만 쓴다. 마감 시각 = 분석 시작 + 분석 제한 - 이 값
# (분석 제한은 AI_TIMEOUT_SECONDS. 작업 시작이 늦었거나 모델 준비가 길었으면 그만큼 짧아진다)
# modeling 은 마감에 걸린 LLM 호출의 응답을 마감 + 5초까지 기다리므로 5초보다 길게 둔다.
# AI_PROVIDER=modeling 이면 AI_TIMEOUT_SECONDS 보다 작아야 한다(아니면 서버가 시작하지 않는다)
AI_DEADLINE_MARGIN_SECONDS=10
# ENV=production 에서 AI_PROVIDER=pipeline 을 일부러 쓸 때만 true(가상 데이터 시험용).
# local/test 에서는 보지 않는다. 실제 상담 데이터가 있는 서버에서는 켜지 않는다.
AI_PIPELINE_ALLOW_UNMASKED=false
# ENV=production 에서 AI_PROVIDER=modeling 을 일부러 쓸 때만 true(가상 데이터 시험용).
# local/test 에서는 보지 않는다. 개인정보 문제가 해결되기 전에는 실제 상담 데이터가 있는 서버에서 켜지 않는다.
AI_MODELING_ALLOW_IN_PRODUCTION=false

# AI_PROVIDER=pipeline / langgraph / modeling 일 때 LLM 호출에 사용하는 값
# (modeling 은 OPENAI_MODEL 을 읽지 않는다 — 모델 이름은 ai/modeling/abuse 쪽에서 정한다)
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------
# 법령 · 매뉴얼 AI 질문 (LawGuide 화면, API_CONTRACT 17절)
# ---------------------------------------------------------
# off      : 창구를 막는다(503 LAW_QA_DISABLED)
# mock     : OpenAI 없이 고정 답변 + 조문 1개(화면 개발 · CI)
# modeling : ai/modeling/abuse/legal_manual_qa_llm 호출(이경진 님). openai 와 law/ · manual/ 패키지, OPENAI_API_KEY 가 필요하다.
#            질문은 가린 뒤 OpenAI 로 나간다. ENV=production 에서는 LAW_QA_ALLOW_IN_PRODUCTION=true 가 없으면 서버가 시작하지 않는다.
#            매뉴얼 사진은 기관 대외비라 MANUAL_QA_ATTACH_IMAGES(기본 false)를 켜지 않는 한 첨부되지 않는다 — 법령만으로 답한다.
LAW_QA_PROVIDER=mock
# 질문 한 번의 제한 시간(초). 넘으면 504 AI_TIMEOUT. modeling 이면 AI_DEADLINE_MARGIN_SECONDS 보다 커야 한다.
LAW_QA_TIMEOUT_SECONDS=60
# 사용자당 분당 호출 한도(넘으면 429 RATE_LIMITED) · 서버 전체 동시 실행 건수(자리가 없으면 제한 시간만큼 기다렸다가 504)
LAW_QA_RATE_LIMIT_PER_MINUTE=6
LAW_QA_MAX_CONCURRENCY=2
# ENV=production 에서 LAW_QA_PROVIDER=modeling 을 일부러 쓸 때만 true(가상 데이터 시험용).
LAW_QA_ALLOW_IN_PRODUCTION=false
# 국가법령정보센터 OPEN API 인증값(법령 캐시가 없거나 오래됐을 때만 조회) · 법령 캐시 폴더(비우면 law/ 기본값 law_cache/).
# 여기 적으면 서버가 process 환경으로 넘긴다(law/config.py 가 os.getenv 로 읽는다).
LAW_API_OC=
LAW_CACHE_DIR=

# ---------------------------------------------------------
# 다음 상담 체크리스트 (FollowupQ '다음 상담 전 확인할 사항' · 추가 질문 공식 근거, API_CONTRACT 19절)
# ---------------------------------------------------------
# off    : 만들지 않는다(기본). 화면은 AI 확인 메모만 보인다.
# mock   : OpenAI 없이 이번 회차 첫 아동 발화로 '(예시)' 결과(화면 개발 · CI).
# module : rag/ 패키지(팀장님 공식 근거 RAG) 호출. requirements-rag.txt 패키지 · rag 색인 · OPENAI_API_KEY 가 필요하다.
#          아동 발화 · 앞 회차 기록 · 추가 질문 초안은 가린 뒤 OpenAI 로 나간다(분석 한 번마다 rag 근거 분석 + 확인 사항 추출 +
#          공식 근거 연결 · 검토 LLM). ENV=production 에서는 FOLLOWUP_ALLOW_IN_PRODUCTION=true 가 없으면 서버가 시작하지 않는다.
FOLLOWUP_PROVIDER=off
# 한 번 만들기의 제한 시간(초) · 서버 전체 동시 실행 건수(시간을 넘긴 작업도 끝날 때까지 자리를 쥔다)
FOLLOWUP_TIMEOUT_SECONDS=240
FOLLOWUP_MAX_CONCURRENCY=1
# ENV=production 에서 FOLLOWUP_PROVIDER=module 을 일부러 쓸 때만 true(가상 데이터 시험용).
FOLLOWUP_ALLOW_IN_PRODUCTION=false
# rag 색인 폴더 · 분석 모델. 비우면 rag 기본값(rag_storage/chroma · rag/config.py)을 쓴다.
# Docker env-file 로 빈 값을 넘기지 않도록 쓸 때만 주석을 푼다.
# RAG_VECTOR_DB_DIR=
# RAG_ANALYZER_MODEL=

# ---------------------------------------------------------
# 처리 대기 업무 목록 (/tasks)
# ---------------------------------------------------------
# 기다리기 시작한 뒤 이 시간(시간 단위)이 지나면 "지연"으로 표시한다.
TASK_OVERDUE_HOURS=48

# ---------------------------------------------------------
# seed script 전용 (선택)
# ---------------------------------------------------------
SEED_USER_PASSWORD=
