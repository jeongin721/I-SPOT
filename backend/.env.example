# I-SPOT Backend 환경변수 예시
# 실제 .env 파일은 git 에 커밋하지 않는다.

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
ENV=local
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# docker compose 사용 시 host 는 db, 로컬 직접 실행 시 localhost
DATABASE_URL=postgresql+psycopg://ispot:ispot@localhost:5432/ispot
DB_ECHO=false

# ---------------------------------------------------------
# Auth
# ---------------------------------------------------------
# 32 byte 이상 임의 문자열을 사용한다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------------------------------------------------
# 비밀번호 규칙 (새로 정하는 비밀번호에만 적용)
# ---------------------------------------------------------
# 기본값은 팀 회의 결정(2026-09-18) "8자 이상, 영문·숫자·특수문자 포함" 이다.
# 종류는 글자·숫자·특수문자 3가지로 세므로 3 이면 전부 포함해야 한다.
# PASSWORD_PASSPHRASE_LENGTH: 이 길이 이상이면 종류를 보지 않는다. 0 이면 면제 없음(팀 결정).
# 켤 때는 12~72 만 받는다.
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_CLASSES=3
PASSWORD_PASSPHRASE_LENGTH=0

# ---------------------------------------------------------
# 계정 상태 (팀 회의 결정 2026-09-18)
# ---------------------------------------------------------
# LOGIN_LOCK_MINUTES=0 이면 시간이 지나도 풀리지 않고 관리자만 해제한다.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=0
DORMANT_AFTER_DAYS=60
TEMP_PASSWORD_VALID_HOURS=72
# 이전 비밀번호 재사용 금지에 쓸 보관 개수. 0 이면 검사하지 않는다.
PASSWORD_HISTORY_COUNT=3

# ---------------------------------------------------------
# CORS (Frontend 주소)
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------
# Audio Storage (9월 MVP 는 Local Storage)
# ---------------------------------------------------------
AUDIO_STORAGE_ROOT=../storage/audio
AUDIO_MAX_SIZE_MB=200
AUDIO_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.mp4,.ogg,.flac,.webm

# ---------------------------------------------------------
# STT (팀 A)
# ---------------------------------------------------------
# mock   : 팀 A 산출물 없이 Backend 단독 실행/통합
# module : 실제 STT 함수 호출
STT_PROVIDER=mock
STT_MODULE=stt.transcribe_service
STT_FUNCTION=transcribe
STT_TIMEOUT_SECONDS=600

# ---------------------------------------------------------
# stt/ 패키지 내부 설정 (STT_PROVIDER=module 일 때만 사용)
# ---------------------------------------------------------
# 위 STT_PROVIDER 는 "Backend 가 STT 모듈을 호출할지" 를 정하고,
# 아래 I_SPOT_* 는 "그 모듈이 어떤 엔진으로 받아쓸지" 를 정한다.
#
# mock     : 오프라인 대체 구현 (기본값, 키 불필요)
# whisper  : OpenAI Whisper  -> OPENAI_API_KEY
# deepgram : Deepgram        -> DEEPGRAM_API_KEY
# clova    : CLOVA Speech    -> I_SPOT_STT_API_KEY / I_SPOT_STT_API_URL
I_SPOT_STT_PROVIDER=elevenlabs
I_SPOT_STT_FALLBACK_PROVIDER=deepgram
# Opt-in prototype only; keep disabled until runtime replay validation passes.
I_SPOT_SINGLE_SPEAKER_FALLBACK=off
I_SPOT_STT_API_KEY=
I_SPOT_STT_API_URL=

# 1/true/yes/on 이면 동일 화자의 연속 발화를 병합하는 후처리를 적용한다.
I_SPOT_STT_POSTPROCESS=

# 화자 분리(diarization)
# mock     : 로컬 개발용 시뮬레이션 (기본값)
# pyannote : 실제 모델 사용 -> PYANNOTE_AUTH_TOKEN 및 pyannote-audio 별도 설치 필요
I_SPOT_SPEAKER_DIARIZATION_PROVIDER=mock
I_SPOT_SPEAKER_DIARIZATION_MODEL=
PYANNOTE_AUTH_TOKEN=

# stt/ispot_stt.py(Deepgram provider) 에서 사용
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_LANGUAGE_CODE=kor
ELEVENLABS_DIARIZE=true

# stt/ispot_analyzer.py(Groq LLM 위험도 분석) 에서 사용
GROQ_API_KEY=

# ---------------------------------------------------------
# AI (팀 B)
# ---------------------------------------------------------
# mock      : Transcript 에서 파생한 합성 요약 반환. 외부 호출 없음
# pipeline  : ai/services/analysis_pipeline.run_analysis_pipeline 호출
# langgraph : agent/graph.run 호출 (비식별 → 분석 → 근거판정 → RAG → 재분석)
#             pip install -r ../requirements-agent.txt 가 선행되어야 한다
#             외부 LLM 호출 전 비식별 필수(9/18 회의 결정). 비식별은 아직
#             연결 전이고, 지금 그래프 노드는 LLM 을 부르지 않는다
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=180

# AI_PROVIDER=pipeline / langgraph 일 때 LLM 호출에 사용하는 값
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------
# 처리 대기 업무 목록 (/tasks)
# ---------------------------------------------------------
# 기다리기 시작한 뒤 이 시간(시간 단위)이 지나면 "지연"으로 표시한다.
TASK_OVERDUE_HOURS=48

# ---------------------------------------------------------
# seed script 전용 (선택)
# ---------------------------------------------------------
SEED_USER_PASSWORD=
