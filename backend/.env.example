# I-SPOT Backend 환경변수 예시
# 실제 .env 파일은 git 에 커밋하지 않는다.

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
ENV=local
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# docker compose 사용 시 host 는 db, 로컬 직접 실행 시 localhost
DATABASE_URL=postgresql+psycopg://ispot:ispot@localhost:5432/ispot
DB_ECHO=false

# ---------------------------------------------------------
# Auth
# ---------------------------------------------------------
# 32 byte 이상 임의 문자열을 사용한다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------------------------------------------------
# CORS (Frontend 주소)
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------
# Audio Storage (9월 MVP 는 Local Storage)
# ---------------------------------------------------------
AUDIO_STORAGE_ROOT=../storage/audio
AUDIO_MAX_SIZE_MB=200
AUDIO_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.mp4,.ogg,.flac,.webm

# ---------------------------------------------------------
# STT (팀 A)
# ---------------------------------------------------------
# mock   : 팀 A 산출물 없이 Backend 단독 실행/통합
# module : 실제 STT 함수 호출
STT_PROVIDER=mock
STT_MODULE=stt.transcribe_service
STT_FUNCTION=transcribe
STT_TIMEOUT_SECONDS=600

# ---------------------------------------------------------
# AI (팀 B)
# ---------------------------------------------------------
# mock     : 고정된 합성 요약 반환
# pipeline : ai/services/analysis_pipeline.run_analysis_pipeline 호출
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=180

# AI_PROVIDER=pipeline 일 때 팀 B 파이프라인이 사용하는 값
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------
# seed script 전용 (선택)
# ---------------------------------------------------------
SEED_USER_PASSWORD=
