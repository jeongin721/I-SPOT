# 줄바꿈 정책.
#
# 팀이 Windows + Git Bash 환경에서 작업하고 core.autocrlf=true 인 경우,
# .sh 파일이 CRLF 로 체크아웃되면 bash 가 아래처럼 실패한다.
#
#   bash: ./scripts/check.sh: /usr/bin/env: bad interpreter: No such file or directory
#
# 따라서 실행 스크립트는 작업 트리에서도 LF 를 강제한다.

# 기본: git 이 텍스트 여부를 판별하고 저장소에는 LF 로 보관한다.
* text=auto

# 셸 스크립트는 반드시 LF (Windows 에서도)
*.sh text eol=lf

# 상담 음성은 커밋하지 않지만(.gitignore) 안전장치로 바이너리 처리한다.
*.wav binary
*.mp3 binary
*.m4a binary
*.ogg binary
*.flac binary
*.webm binary
