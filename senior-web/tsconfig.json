// 서버 연결 부분(src/api · src/data)만 TypeScript 로 검사한다. 화면(.jsx)은 JavaScript 그대로다.
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@cw/*": ["../counselor-web/src/*"] }
  },
  "include": ["src/api", "src/data", "src/vite-env.d.ts"]
}
